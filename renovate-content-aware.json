{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Track governance imports by package content instead of every main commit. Extend alongside renovate-governor.",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track package branches; declare git, path and ref in this order within each import.",
      "managerFilePatterns": [
        "/^\\.please/config\\.toml$/"
      ],
      "matchStrings": [
        "git\\s*=\\s*\"(?<packageName>https://github\\.com/christianpflugradt/please-behave-governance\\.git)\"[^\\[]*?path\\s*=\\s*\"(?<importPath>(?:rulesets|providers)/[a-z0-9-]+)\"[^\\[]*?ref\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "please-behave-governance/{{{importPath}}}",
      "currentValueTemplate": "updates/{{{importPath}}}"
    },
    {
      "customType": "regex",
      "description": "Track pinned shared mise task groups in the root mise.toml.",
      "managerFilePatterns": [
        "/^\\.?mise\\.toml$/"
      ],
      "matchStrings": [
        "git::(?<packageName>https://github\\.com/christianpflugradt/please-behave-governance\\.git)//(?<importPath>mise-tasks/[a-z0-9-]+)\\?ref=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "please-behave-governance/{{{importPath}}}",
      "currentValueTemplate": "updates/{{{importPath}}}"
    },
    {
      "customType": "regex",
      "description": "Track pinned governance actions in the workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "uses:\\s*christianpflugradt/please-behave-governance/(?<importPath>actions/[a-z0-9-]+)/[a-z0-9-]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/christianpflugradt/please-behave-governance.git",
      "depNameTemplate": "please-behave-governance/{{{importPath}}}",
      "currentValueTemplate": "updates/{{{importPath}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Governance actions are tracked by the custom manager, not by the inherited GitHub Actions manager.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["christianpflugradt/please-behave-governance/**"],
      "enabled": false
    },
    {
      "description": "Disable the inherited whole-repository dependency in favor of content-aware package tracking.",
      "matchDatasources": [
        "git-refs"
      ],
      "matchDepNames": [
        "please-behave-governance"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "git-refs"
      ],
      "matchDepNames": [
        "please-behave-governance/**"
      ],
      "groupName": "governance imports"
    }
  ]
}
