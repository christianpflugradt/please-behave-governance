#!/usr/bin/env python3
# MISE description="Wait for CI on main, then start the Release workflow; --follow watches the run"
# USAGE flag "--follow" help="Watch the dispatched release run until it finishes"
# USAGE flag "--force" help="Release a patch version even if no commit would raise the version, to test the release process"
# USAGE flag "--prerelease" help="Publish a development prerelease of the latest stable release instead of an official release"
# USAGE flag "--release" help="Publish an official release even if the workflow defaults to a prerelease"
"""Start the Release workflow once CI on main is idle; with --follow, watch the run.

--force, --prerelease and --release are passed to the workflow as the dispatch inputs `force` and `mode`;
the workflow must declare them.
"""

import json
import os
import subprocess
import sys
import time

WORKFLOW = os.environ.get("RELEASE_WORKFLOW", "release.yml")
CI_WORKFLOW = os.environ.get("RELEASE_CI_WORKFLOW", "ci.yml")
CI_POLL_SECONDS = 15


def run(*command, capture=True):
    result = subprocess.run(command, check=False, capture_output=capture, text=True)
    if result.returncode:
        detail = (result.stderr or "").strip()
        raise ValueError(f"`{' '.join(command)}` failed" + (f": {detail}" if detail else "."))
    return result.stdout.strip() if capture else ""


def run_ids():
    runs = json.loads(
        run(
            "gh",
            "run",
            "list",
            "--workflow",
            WORKFLOW,
            "--branch",
            "main",
            "--event",
            "workflow_dispatch",
            "--limit",
            "20",
            "--json",
            "databaseId",
        )
    )
    return {item["databaseId"] for item in runs}


def running_ci():
    """Return the IDs of unfinished CI runs on main."""
    runs = json.loads(
        run("gh", "run", "list", "--workflow", CI_WORKFLOW, "--branch", "main", "--limit", "20", "--json", "databaseId,status")
    )
    return [item["databaseId"] for item in runs if item["status"] != "completed"]


def wait_for_ci():
    """Block until no CI run on main is queued or in progress."""
    announced = None
    while pending := running_ci():
        if pending != announced:
            print(f"Waiting for CI run(s) {', '.join(map(str, pending))} to finish", flush=True)
            announced = pending
        time.sleep(CI_POLL_SECONDS)


def dispatch(fields=()):
    """Dispatch the workflow and return the new run's ID."""
    known = run_ids()
    run("gh", "workflow", "run", WORKFLOW, "--ref", "main", *fields)
    for _ in range(30):
        time.sleep(2)
        if new := run_ids() - known:
            return max(new)
    raise ValueError("The dispatched release run did not appear; check GitHub Actions.")


FLAGS = {"--follow", "--force", "--prerelease", "--release"}


def dispatch_fields(force, prerelease, official=False):
    """The `gh workflow run` fields for the requested dispatch inputs."""
    mode = ["-f", "mode=prerelease"] if prerelease else ["-f", "mode=release"] if official else []
    return [*(["-f", "force=true"] if force else []), *mode]


def release(follow, force=False, prerelease=False, official=False):
    wait_for_ci()
    fields = dispatch_fields(force, prerelease, official)
    if not follow:
        run("gh", "workflow", "run", WORKFLOW, "--ref", "main", *fields, capture=False)
        return
    run_id = dispatch(fields)
    print(f"Watching release run {run_id}", flush=True)
    run("gh", "run", "watch", str(run_id), "--exit-status", capture=False)


if __name__ == "__main__":
    try:
        flags = set(sys.argv[1:])
        if not flags <= FLAGS or len(flags) != len(sys.argv[1:]):
            raise ValueError("Usage: mise release [--follow] [--force] [--prerelease | --release]")
        if {"--prerelease", "--release"} <= flags:
            raise ValueError("Use either --prerelease or --release")
        release("--follow" in flags, "--force" in flags, "--prerelease" in flags, "--release" in flags)
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        sys.exit(f"Release failed: {error}")
