{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/christianpflugradt/please-behave-governance/why/schemas/mise-task.schema.json",
  "title": "Mise task why document",
  "description": "Guiding question: Why does this task exist and why does it behave as it does?\n\nIt records why, and never repeats what the definition already states, such as types, defaults and the order of steps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "problem",
    "value",
    "decisions",
    "principles",
    "placement",
    "safety"
  ],
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence stating what it is meant to achieve."
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "description": "What goes wrong without it and why that matters: the risk and its consequence."
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "description": "The benefit while it works as intended."
    },
    "decisions": {
      "$ref": "common.schema.json#/$defs/decisions"
    },
    "out_of_scope": {
      "$ref": "common.schema.json#/$defs/out_of_scope"
    },
    "limitations": {
      "$ref": "common.schema.json#/$defs/limitations"
    },
    "placement": {
      "type": "string",
      "minLength": 1,
      "description": "Why it is shared in the governance repository and not local to each repository, or why it is local."
    },
    "revisit_when": {
      "$ref": "common.schema.json#/$defs/revisit_when"
    },
    "references": {
      "$ref": "common.schema.json#/$defs/references"
    },
    "flags": {
      "$ref": "common.schema.json#/$defs/named_reasons",
      "description": "Why each flag exists, by flag name."
    },
    "waits_for": {
      "type": "string",
      "minLength": 1,
      "description": "What the task waits for before it acts, and why."
    },
    "safety": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "What the task guarantees so that running it is safe.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "why"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supported_variations": {
      "$ref": "common.schema.json#/$defs/supported_variations"
    },
    "principles": {
      "$ref": "common.schema.json#/$defs/principles"
    }
  }
}
