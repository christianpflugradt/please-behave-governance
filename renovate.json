{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "extends": [
    "config:best-practices",
    ":maintainLockFilesMonthly",
    "github>christianpflugradt/repository-catalog:renovate-governor",
    "github>christianpflugradt/repository-catalog:renovate-content-aware"
  ],
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": ["!please-behave/cli", "!please-behave/action"]
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": ["!please-behave/action"]
    }
  ]
}
