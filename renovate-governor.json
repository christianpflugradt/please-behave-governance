{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Keep the published Please Behave governor, the Please Behave action and the pinned shared revisions current after successful CI.",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the commit pins of Please Behave imports in .please/config.toml on the default branch.",
      "managerFilePatterns": ["/^\\.please/config\\.toml$/"],
      "matchStrings": [
        "git\\s*=\\s*\"(?<packageName>https://github\\.com/christianpflugradt/please-behave-governance\\.git)\"[^\\[]*?ref\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\"",
        "ref\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\"[^\\[]*?git\\s*=\\s*\"(?<packageName>https://github\\.com/christianpflugradt/please-behave-governance\\.git)\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "please-behave-governance",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track the commit pins of shared mise task groups and ruleset tool files in the root mise.toml on the default branch.",
      "managerFilePatterns": ["/^\\.?mise\\.toml$/"],
      "matchStrings": [
        "git::(?<packageName>https://github\\.com/christianpflugradt/please-behave-governance\\.git)//(?:mise-tasks/[a-z0-9-]+|rulesets/[a-z0-9-]+/mise\\.toml)\\?ref=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "please-behave-governance",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track the commit pins of governance actions in the workflows on the default branch.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s*christianpflugradt/please-behave-governance/actions/[a-z0-9-]+(?:/[a-z0-9-]+)?@(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/christianpflugradt/please-behave-governance.git",
      "depNameTemplate": "please-behave-governance",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track the commit pins of governance release and statistics workflows in the workflows on the default branch.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s*christianpflugradt/please-behave-governance/\\.github/workflows/(?:release|statistics)-[a-z-]+\\.yml@(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/christianpflugradt/please-behave-governance.git",
      "depNameTemplate": "please-behave-governance",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "description": "Governance actions are tracked by the custom manager, not by the inherited GitHub Actions manager.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["christianpflugradt/please-behave-governance/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["please-behave/cli"],
      "matchManagers": ["mise"],
      "matchDatasources": ["github-releases"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "ignoreUnstable": true,
      "minimumReleaseAge": "0 days",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchPackageNames": ["please-behave/action"],
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "ignoreUnstable": true,
      "minimumReleaseAge": "0 days",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchPackageNames": ["https://github.com/christianpflugradt/please-behave-governance.git"],
      "matchDatasources": ["git-refs"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ]
}
